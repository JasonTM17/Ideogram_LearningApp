# DeepSeek server-only configuration.
# Never expose DEEPSEEK_API_KEY through NEXT_PUBLIC_* or EXPO_PUBLIC_* variables.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TUTOR_THINKING_MODE=disabled
DEEPSEEK_GRADING_THINKING_MODE=enabled
DEEPSEEK_REASONING_EFFORT=high

# Supabase publishable configuration. These values are safe for client runtimes;
# authorization still depends on RLS and a verified user session.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Mobile reads the learner catalog through this public API origin. Production
# requires HTTPS; loopback HTTP is accepted only by a development build.
EXPO_PUBLIC_API_ORIGIN=http://127.0.0.1:3000
# Development falls back to ideogram-learning://auth/callback. Production must
# supply an exact claimed HTTPS Universal Link / App Link, with no query or hash.
EXPO_PUBLIC_AUTH_CALLBACK_URL=

# Server-only PostgreSQL login used by the Next.js learning mutation routes.
# Production must use a dedicated LOGIN that can SET ROLE app_learning_api_executor.
LEARNING_DATABASE_URL=
# Keep replicas * pool max at or below 16 to preserve headroom under the login's
# 20-connection database limit. Allowed runtime range: 1-5.
LEARNING_DATABASE_POOL_MAX=2

# Canonical web origin used for cookie-based mutation origin checks.
APP_ORIGIN=http://127.0.0.1:3000

# Enable only when a trusted ingress overwrites x-forwarded-for/x-real-ip.
TRUST_PROXY_IP_HEADERS=false
