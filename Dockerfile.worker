FROM node:26-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable
WORKDIR /workspace

FROM base AS builder

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps/worker/package.json apps/worker/package.json

RUN pnpm install --frozen-lockfile --filter @ideogram/worker...

COPY apps/worker apps/worker
RUN pnpm --filter @ideogram/worker build \
  && pnpm --filter @ideogram/worker --prod deploy --legacy /worker

FROM node:26-alpine@sha256:233761595746769ebfdb6090f44fc7cdf818ae0ce62d2b37e0367723b9823e36 AS runner

ENV NODE_ENV="production"

RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v1.22.22 \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
  && addgroup --system --gid 1001 ideogram \
  && adduser --system --uid 1001 --ingroup ideogram worker

WORKDIR /app

LABEL org.opencontainers.image.source="https://github.com/JasonTM17/Ideogram_LearningApp"
LABEL org.opencontainers.image.description="Placement-scoring worker for Ideogram Learning"

COPY --from=builder --chown=worker:ideogram /worker ./

USER worker

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "try { process.kill(1, 0); } catch { process.exit(1); }"

CMD ["node", "dist/main.js"]
