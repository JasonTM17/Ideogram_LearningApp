{
  "name": "@ideogram/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "2.111.0"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --platform node --target node24 --out-dir dist --clean --sourcemap",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint src scripts --max-warnings=0",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:integration:placement": "tsx scripts/placement-scoring.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "pg": "8.22.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
